        "cvssV3_vector": "CVSS:4.0/AV:L/AC:H/AT:P/PR:N/UI:N/VC:L/VI:L/VA:N/SC:L/SI:L/SA:N/E:P/RE:L/U:Green",
        "fixed_version": "1.5.33",
        "purls": [
         "pkg:maven/ch.qos.logback/logback-core@1.5.32"
        ],
        "security-severity": "1.2",
        "tags": [
         "LOW"
