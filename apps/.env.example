# Copiar a .env junto al compose que se use (en la EC2: ~/barriodigital/.env).
# Nunca subir .env ni el wallet a git. Valores de Entra ID: docs/decisiones.md

# --- BFF ---
AZURE_ISSUER_URI=https://login.microsoftonline.com/ce6e98c4-63f0-4b79-83e5-20925b5fada2/v2.0
# Los tokens v2 traen aud = GUID del client id; sin él el BFF responde 401
AZURE_AUDIENCES=api://a0773f3e-abc6-4b53-86fc-9d33a2eddef3,a0773f3e-abc6-4b53-86fc-9d33a2eddef3
# Orígenes del front separados por coma
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- requests (Oracle Autonomous) ---
# Dentro del contenedor el wallet se monta en /wallet
ORACLE_URL=jdbc:oracle:thin:@barriodig_low?TNS_ADMIN=/wallet
ORACLE_USER=
# Si tiene $, escribirlo como $$
ORACLE_PASSWORD=

# Solo compose.yml: ruta del wallet en el host (por defecto ./wallet)
# WALLET_HOST_PATH=

# --- catalog ---
# Usa las mismas ORACLE_* y el mismo wallet que requests. No publica puerto.
# El compose asigna esta URL al BFF. No poner localhost: dentro de la red el nombre es catalog.
CATALOG_BASE_URL=http://catalog:8082

# --- RabbitMQ: Requests y Notify (EP2-18 / EP2-22) ---
# Local: MQ debe estar arriba. Nombres resolubles en su red Docker.
# EC2: reemplazar por DNS o IP PRIVADA de EC2-MQ:5672 (solo nodo 1).
RABBIT_ADDRESSES=rabbitmq-1:5672,rabbitmq-2:5672
RABBIT_USER=barriodigital
# Mismo valor que RABBITMQ_DEFAULT_PASS del entorno MQ. No copiar la cookie.
RABBIT_PASSWORD=
# Solo local; ajustar si MQ se arrancó con otro nombre de proyecto.
RABBIT_NETWORK_NAME=barriodigital-mq_default
# Compose fija CERTIFICATE_OUTPUT_DIR=/app/data/certificates y monta certificates.
# Logging no envía correos. SMTP requiere activación y configuración explícitas.
EMAIL_MODE=logging
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS_ENABLE=false
SMTP_STARTTLS_REQUIRED=false
SMTP_CONNECTION_TIMEOUT=5000
SMTP_READ_TIMEOUT=5000
SMTP_WRITE_TIMEOUT=5000
