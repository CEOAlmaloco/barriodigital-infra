# Copiar a mq/.env. Nunca subir .env a git.
# Si la password o la cookie tienen $, en este archivo va como $$.

RABBITMQ_DEFAULT_USER=barriodigital
RABBITMQ_DEFAULT_PASS=cambiar-esto
RABBITMQ_ERLANG_COOKIE=cambiar-esta-cookie-de-cluster

# Dirección del HOST para publicar AMQP del nodo 1. Local: loopback.
# En EC2-MQ: IP privada de su interfaz, con conectividad desde EC2-Apps.
# Management permanece en 127.0.0.1; el nodo 2 no publica puertos.
RABBIT_AMQP_BIND_ADDRESS=127.0.0.1
