# Copiar a mq/.env. Nunca subir .env a git.
# Si la password o la cookie tienen $, en este archivo va como $$.

RABBITMQ_DEFAULT_USER=barriodigital
RABBITMQ_DEFAULT_PASS=cambiar-esto
RABBITMQ_ERLANG_COOKIE=cambiar-esta-cookie-de-cluster

# Dirección del HOST para publicar AMQP del nodo 1. Local: loopback.
# En EC2-MQ: IP privada de su interfaz. El security group solo admite a ec2-apps.
# No usar 0.0.0.0 aquí: publicaría AMQP también por la IP pública.
RABBIT_AMQP_BIND_ADDRESS=127.0.0.1
# Management del nodo 1. Local: loopback.
# En EC2-MQ: 0.0.0.0, para que la IP pública llegue al contenedor.
# El security group de 15672 solo admite la IP del equipo, nunca 0.0.0.0/0.
RABBIT_MGMT_BIND_ADDRESS=127.0.0.1
