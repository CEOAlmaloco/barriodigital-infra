# Copiar a kafka/.env. Nunca subir .env a git.

# IP del HOST que se anuncia en el listener EXTERNAL de los brokers.
# Los clientes fuera de Docker conectan a <KAFKA_HOST_IP>:9092/9093/9094.
# Local: IP LAN del PC (ipconfig) si otros equipos deben llegar, o 127.0.0.1 si solo es esta máquina.
# Si KAFKA_HOST_IP=127.0.0.1, otros contenedores de otros compose NO lo resuelven: usar la IP LAN.
KAFKA_HOST_IP=127.0.0.1

# Dirección del HOST donde se publican los puertos 9092-9094 y la UI.
# Local: loopback. Si se quiere exponer a la LAN, poner 0.0.0.0 (el firewall decide).
KAFKA_BIND_ADDRESS=127.0.0.1
KAFKA_UI_BIND_ADDRESS=127.0.0.1

# Login de Kafka UI (http://localhost:8090). Sin secretos reales en git.
KAFKA_UI_USER=admin
KAFKA_UI_PASSWORD=cambiar-esto
